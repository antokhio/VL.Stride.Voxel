<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <BaseOutputPath>..\lib\</BaseOutputPath>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <NoWarn>$(NoWarn);1591</NoWarn>
  </PropertyGroup>
  <ItemGroup>
      <PackageReference Include="Stride.Voxels" Version="$(StrideVersion)" GeneratePathProperty="true" />
      <PackageReference Include="VL.Core" Version="$(VLVersion)" />
      <PackageReference Include="VL.Stride.Runtime" Version="$(VLVersion)" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Stride.Core.Assets.CompilerApp" Version="$(StrideVersion)">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>build;buildTransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>
</Project>
